@model List<Order>
@{
    ViewData["Title"] = "My Orders";
}
<section class="page-banner compact"><span class="eyebrow">ORDER HISTORY</span><h1>My Orders</h1></section>
<div class="table-wrap">
<table>
<thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead>
<tbody>
@foreach (var o in Model)
{
<tr><td>#@o.Id</td><td>@o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td><td>Rs. @o.TotalAmount.ToString("N2")</td><td><span class="status @o.Status.ToLower()">@o.Status</span></td><td><a class="btn small" asp-action="Invoice" asp-route-id="@o.Id">View Invoice</a></td></tr>
}
</tbody>
</table>
</div>
